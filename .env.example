# Diet Pro Planner local environment example.
# Copy this file to .env on your Raspberry Pi and fill your own private values.
# Never commit .env, tokens or local databases.

APP_PORT=8099
# Required: long random token (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
DPP_AUTH_TOKEN=replace_with_a_long_random_token
# Set to 1 when the app is served over HTTPS behind a reverse proxy.
DPP_COOKIE_SECURE=0
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted.
DPP_TRUSTED_PROXIES=

# Optional Strava integration.
# Create a Strava API app and use localhost OAuth through an SSH tunnel.
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:8099/api/strava/callback

# Optional AI (BYOK, disabled when empty). Keys stay in .env, never in the database.
# Claude (recommended):
ANTHROPIC_API_KEY=
# DPP_AI_MODEL=claude-opus-5-5
# DPP_AI_EFFORT=medium
# Or an OpenAI-compatible endpoint (Ollama on the Pi/LAN, LM Studio, OpenAI, Gemini compat):
# DPP_AI_PROVIDER=openai_compat
# DPP_AI_BASE_URL=http://192.168.1.10:11434/v1
# DPP_AI_MODEL=llama3.1
# DPP_AI_API_KEY=
DPP_AI_DAILY_LIMIT=30

# Food database lookups (Open Food Facts). Only barcodes/search text leave the Pi.
DPP_OFF_ENABLED=1
DPP_OFF_COUNTRY=es

# Daily SQLite snapshots kept in data/backups (0 disables).
DPP_BACKUP_KEEP=14
# Max upload size for label photos (MB).
DPP_MAX_UPLOAD_MB=15
